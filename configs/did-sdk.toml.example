# did-sdk 配置示例（Client）
# 全部字段都有默认值；仅当 DID_SDK_CONFIG_FILE 或 {DID_SDK_HOME}/did-sdk.toml 存在时读取。

[did_sdk]
mode = "mock"                 # mock / centralized
subject_kind = "client"       # client / server
vc_storage_path = "./vc_store"
cache_ttl_secs = 600

[did_sdk.key_vault]           # 仅 Client 使用
scheme = "file-keystore"      # file-keystore / memory-keystore
# path / password_env / password_file / allow_auto_generate_password
# 省略时使用内置默认值。

[did_sdk.centralized]
# endpoint = "http://127.0.0.1:8080"
# Server 示例（由 chain-sdk / chain-owner-sdk 装配；默认启用 FileKeystore）
# [did_sdk]
# mode = "centralized"
# subject_kind = "server"
# participant_did = "did:web:issuer.example.com:mail"
# vc_storage_path = "./participant-vc-store"
