from typing import Any, Dict, List, Optional

__version__: str

class DidSdkError(RuntimeError): ...
class UserRejectedError(DidSdkError): ...
class NotFoundError(DidSdkError): ...
class InvalidArgumentError(ValueError): ...

class DidSdk:
    def __init__(
        self,
        *,
        mode: Optional[str] = ...,
        vc_storage_path: Optional[str] = ...,
        key_vault_path: Optional[str] = ...,
        key_vault_scheme: Optional[str] = ...,
        key_vault_password: Optional[str] = ...,
        key_vault_password_file: Optional[str] = ...,
        centralized_endpoint: Optional[str] = ...,
        chain_endpoint: Optional[str] = ...,
        cache_ttl_secs: Optional[int] = ...,
    ) -> None: ...
    async def generate_did_key(self) -> str: ...
    async def sign_with_did_key(
        self,
        message: bytes,
        *,
        purpose: str = ...,
        payload_summary: str = ...,
        requestor: Optional[str] = ...,
    ) -> bytes: ...
    def resolve_did_key(self, did: str) -> bytes: ...
    async def create_did(self) -> Dict[str, Any]: ...
    async def resolve_did(self, did: str) -> Optional[Dict[str, Any]]: ...
    async def issue_self_asserted_vc(self, claims: Any) -> Dict[str, Any]: ...
    async def store_vc(self, vc: Any) -> None: ...
    async def get_vc(self, anchor_id: str) -> Optional[Dict[str, Any]]: ...
    async def list_vcs(self) -> List[Dict[str, Any]]: ...
    async def remove_vc(self, anchor_id: str) -> None: ...
    async def build_vp(
        self, vcs: List[Any], challenge: str, domain: str
    ) -> Dict[str, Any]: ...
    async def build_did_signature_header(
        self, from_: str, anchor_id: str, body_hash: str, rcpt_hash: str
    ) -> str: ...
    def verify_did_signature_header(
        self, header: str, from_: str, body_hash: str, rcpt_hash: str
    ) -> Dict[str, Any]: ...
    async def sign_issue_authorization(
        self, subject_did: str, vc_type: str, vc_hash: str, timestamp: int
    ) -> Dict[str, Any]: ...
    async def get_anchor(self, anchor_id: str) -> Dict[str, Any]: ...
    def resolved_config(self) -> Dict[str, Any]: ...
    @staticmethod
    def did_signature_v1_bytes(
        did: str,
        from_: str,
        timestamp: int,
        anchor_ref: str,
        body_hash: str,
        rcpt_hash: str,
    ) -> bytes: ...
    @staticmethod
    def issued_vc_v1_bytes(
        issuer_did: str, subject_did: str, vc_type: str, vc_hash: str
    ) -> bytes: ...
    @staticmethod
    def vp_v1_bytes(
        holder: str, challenge: str, domain: str, vc_hashes: List[str]
    ) -> bytes: ...
    @staticmethod
    def ed25519_sign_with_seed(seed_hex: str, payload: bytes) -> bytes: ...
